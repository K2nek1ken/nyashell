// fastfetch в духе pfetch: маленький логотип, короткие строки, кружочки цветов
// pfetch-style fastfetch: small logo, short lines, colour dots
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // шестерёнка вместо логотипа дистрибутива; цвет 1 — пурпурный терминала, а он у нас = акцент палитры
  // a gear instead of the distro logo; colour 1 is the terminal's magenta, which for us is the palette accent
  "logo": { "type": "file", "source": "~/.config/fastfetch/gear.txt", "color": { "1": "magenta" },
            "padding": { "top": 0, "left": 2, "right": 3 } },
  "display": {
    "separator": "  ",
    "color": { "keys": "magenta", "title": "magenta" },
    "key": { "width": 9 }
  },
  "modules": [
    "break",
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "os",       "key": "ос",     "format": "{name}" },
    { "type": "kernel",   "key": "ядро",   "format": "{release}" },
    { "type": "uptime",   "key": "в сети" },
    { "type": "packages", "key": "пакеты", "format": "{all}" },
    { "type": "wm",       "key": "wm",     "format": "mango · nyashell" },
    { "type": "memory",   "key": "память", "format": "{used} / {total}" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
