pragma Singleton
import Quickshell
import Quickshell.Io
import QtQuick
import "DeltaTheme.js" as DT

// цвета терминала из палитры шелла: kitty (nyash-theme.conf) и fish (conf.d/nyash-colors.fish).
// «смысловые» цвета (красный — ошибки, жёлтый — предупреждения, зелёный — успех) остаются
// узнаваемыми, но подкрашены в сторону акцента и приглушены до пастели, как сама палитра
// terminal colours from the shell palette: kitty (nyash-theme.conf) and fish (conf.d/nyash-colors.fish).
// "meaningful" colours (red for errors, yellow for warnings, green for success) stay
// recognisable but are tinted towards the accent and muted to pastel, like the palette itself
Singleton {
    id: tt
    readonly property string home: Quickshell.env("HOME")

    function hex(c): string { return String(c).slice(0, 7); }
    // оттенок h (0..1) чуть подтянуть к акценту
    // pull hue h (0..1) slightly towards the accent
    function tint(h: real): real {
        const a = Theme.accent.hslHue < 0 ? h : Theme.accent.hslHue;
        let d = a - h; if (d > 0.5) d -= 1; if (d < -0.5) d += 1;
        return (h + d * 0.12 + 1) % 1;
    }
    function tone(h: real, s: real, l: real): string { return hex(Qt.hsla(tint(h), s, l, 1)); }

    readonly property var ansi: {
        const p = Theme.p;
        const acc = Theme.accent, acc2 = Theme.accent2;
        const n = [
            p.surfaceHi,                        // 0 чёрный / 0 black
            tone(0.985, 0.62, 0.70),            // 1 красный   — ошибки / 1 red     — errors
            tone(0.36, 0.40, 0.70),             // 2 зелёный   — успех / 2 green   — success
            tone(0.12, 0.62, 0.72),             // 3 жёлтый    — предупреждения / 3 yellow  — warnings
            tone(0.60, 0.52, 0.74),             // 4 синий / 4 blue
            hex(acc),                           // 5 пурпурный — акцент / 5 magenta — accent
            tone(0.50, 0.40, 0.70),             // 6 голубой / 6 cyan
            p.textDim                           // 7 белый / 7 white
        ];
        const b = [
            p.line,
            tone(0.985, 0.70, 0.78), tone(0.36, 0.48, 0.78), tone(0.12, 0.70, 0.80),
            tone(0.60, 0.60, 0.82), hex(Qt.lighter(acc, 1.08)), tone(0.50, 0.48, 0.78), p.text
        ];
        return n.concat(b).map(x => hex(x));
    }

    readonly property string kitty: {
        const p = Theme.p, a = ansi;
        let s = "# generated by nyashell from the \"" + p.name + "\" palette, do not edit: it gets overwritten\n";
        s += "foreground " + hex(p.text) + "\nbackground " + hex(p.frame) + "\n";
        s += "selection_foreground " + hex(p.onAccent) + "\nselection_background " + hex(p.accent) + "\n";
        s += "cursor " + hex(p.accent) + "\ncursor_text_color " + hex(p.frame) + "\n";
        s += "url_color " + hex(p.accent2) + "\n";
        s += "active_border_color " + hex(p.accent) + "\ninactive_border_color " + hex(p.line) + "\n";
        s += "active_tab_foreground " + hex(p.onAccent) + "\nactive_tab_background " + hex(p.accent) + "\n";
        s += "inactive_tab_foreground " + hex(p.textDim) + "\ninactive_tab_background " + hex(p.surface) + "\n";
        s += "tab_bar_background " + hex(p.frame) + "\n";
        for (let i = 0; i < 16; i++) s += "color" + i + " " + a[i] + "\n";
        return s;
    }

    readonly property string fish: {
        const p = Theme.p, a = ansi, h = (c) => hex(c).slice(1);
        return "# generated by nyashell: fish highlight colours from the palette\n" +
            "set -g nyash_accent " + h(p.accent) + "\nset -g nyash_accent2 " + h(p.accent2) + "\n" +
            "set -g fish_color_command " + h(p.accent) + "\n" +
            "set -g fish_color_keyword " + h(p.accent2) + "\n" +
            "set -g fish_color_param " + h(p.text) + "\n" +
            "set -g fish_color_quote " + a[2].slice(1) + "\n" +
            "set -g fish_color_redirection " + a[6].slice(1) + "\n" +
            "set -g fish_color_operator " + h(p.accent2) + "\n" +
            "set -g fish_color_end " + h(p.accent2) + "\n" +
            "set -g fish_color_error " + a[1].slice(1) + "\n" +
            "set -g fish_color_comment " + h(p.textDim) + "\n" +
            "set -g fish_color_autosuggestion " + h(p.line) + "\n" +
            "set -g fish_color_valid_path --underline\n" +
            "set -g fish_color_search_match --background=" + h(p.surfaceHi) + "\n" +
            "set -g fish_color_selection --background=" + h(p.surfaceHi) + "\n" +
            "set -g fish_pager_color_prefix " + h(p.accent) + " --bold\n" +
            "set -g fish_pager_color_completion " + h(p.text) + "\n" +
            "set -g fish_pager_color_description " + h(p.textDim) + "\n" +
            "set -g fish_pager_color_selected_background --background=" + h(p.surfaceHi) + "\n";
    }

    FileView { id: kf; path: tt.home + "/.config/kitty/nyash-theme.conf"; printErrors: false }
    FileView { id: ff; path: tt.home + "/.config/fish/conf.d/nyash-colors.fish"; printErrors: false }

    function write(): void {
        Quickshell.execDetached(["mkdir", "-p", home + "/.config/kitty", home + "/.config/fish/conf.d"]);
        writeLater.restart();
    }
    Timer {
        id: writeLater
        interval: 300
        onTriggered: {
            kf.setText(tt.kitty);
            ff.setText(tt.fish);
            // открытые kitty перечитывают конфиг по сигналу USR1
            // open kitty instances reread the config on SIGUSR1
            Quickshell.execDetached(["pkill", "-USR1", "-x", "kitty"]);
            // цвета для остальных программ.
            // GTK4/libadwaita и GTK3 с темой adw-gtk3 (её ставит установщик) берут именованные цвета из gtk.css —
            // так перекрашиваются не только акцент, но и фоны окон, панелей, списков (Nemo, DeltaChat-окна GTK и т.д.).
            // KDE/Qt — AccentColor в kdeglobals. Свой gtk.css не затираем — подключаем отдельный файл
            // colours for the other apps.
            // GTK4/libadwaita and GTK3 with the adw-gtk3 theme (the installer sets it) take named colours from gtk.css,
            // so not only the accent is recoloured but also window, panel and list backgrounds (Nemo, DeltaChat GTK windows and so on).
            // KDE/Qt: AccentColor in kdeglobals. Your own gtk.css isn't overwritten, a separate file is included
            if (ShellState.settings.appAccent ?? true) {
                const p = Theme.p, h = (c) => String(c).slice(0, 7);
                const rgb = (c) => [1, 3, 5].map(i => parseInt(h(c).slice(i, i + 2), 16)).join(",");   // «213,186,222» для KDE / "213,186,222" for KDE
                const css = [
                    ["accent_color", p.accent], ["accent_bg_color", p.accent], ["accent_fg_color", p.onAccent],
                    ["window_bg_color", p.frame], ["window_fg_color", p.text],
                    ["view_bg_color", p.frame], ["view_fg_color", p.text],
                    ["headerbar_bg_color", p.frame], ["headerbar_fg_color", p.text], ["headerbar_backdrop_color", p.frame],
                    ["sidebar_bg_color", p.surface], ["sidebar_fg_color", p.text], ["sidebar_backdrop_color", p.surface],
                    ["secondary_sidebar_bg_color", p.surface], ["secondary_sidebar_fg_color", p.text],
                    ["card_bg_color", p.surface], ["card_fg_color", p.text],
                    ["dialog_bg_color", p.surface], ["dialog_fg_color", p.text],
                    ["popover_bg_color", p.surface], ["popover_fg_color", p.text],
                    ["thumbnail_bg_color", p.surface], ["thumbnail_fg_color", p.text],
                    ["theme_bg_color", p.frame], ["theme_fg_color", p.text], ["theme_base_color", p.frame], ["theme_text_color", p.text],
                    ["theme_selected_bg_color", p.accent], ["theme_selected_fg_color", p.onAccent],
                    ["destructive_bg_color", p.danger || "#ffb4ab"], ["error_color", p.danger || "#ffb4ab"]
                ].map(([k, c]) => "@define-color " + k + " " + h(c) + ";").join("\n") + "\n";
                // цветовая схема KDE: те же роли, что у gtk.css
                // KDE colour scheme: the same roles as gtk.css
                const dim = p.textDim, dang = p.danger || "#ffb4ab";
                const groups = {
                    "Colors:Window":  [p.frame, p.surface], "Colors:View": [p.frame, p.surface],
                    "Colors:Button":  [p.surfaceHi, p.surface], "Colors:Tooltip": [p.surface, p.surfaceHi],
                    "Colors:Header":  [p.frame, p.surface], "Colors:Complementary": [p.frame, p.surface],
                    "Colors:Selection": [p.accent, p.accent]
                };
                const lines = [];
                for (const g in groups) {
                    const sel = g === "Colors:Selection", fg = sel ? p.onAccent : p.text;
                    for (const [k, c] of [["BackgroundNormal", groups[g][0]], ["BackgroundAlternate", groups[g][1]],
                                          ["ForegroundNormal", fg], ["ForegroundInactive", sel ? p.onAccent : dim],
                                          ["ForegroundActive", sel ? p.onAccent : p.accent], ["ForegroundLink", sel ? p.onAccent : p.accent],
                                          ["ForegroundVisited", sel ? p.onAccent : p.accent2], ["ForegroundNegative", dang],
                                          ["ForegroundNeutral", p.accent2], ["ForegroundPositive", p.accent],
                                          ["DecorationFocus", p.accent], ["DecorationHover", p.accent]])
                        lines.push(g + "|" + k + "|" + rgb(c));
                }
                lines.push("General|AccentColor|" + rgb(p.accent), "General|ColorScheme|nyashell",
                           "General|TerminalApplication|" + (ShellState.settings.terminal || "kitty"),
                           "WM|activeBackground|" + rgb(p.frame), "WM|activeForeground|" + rgb(p.text),
                           "WM|inactiveBackground|" + rgb(p.frame), "WM|inactiveForeground|" + rgb(dim));
                const kde = lines.join("\n");
                Quickshell.execDetached(["sh", "-c",
                    'acc="$2"; for v in gtk-3.0 gtk-4.0; do d="$HOME/.config/$v"; mkdir -p "$d"; printf "%s" "$1" > "$d/nyash-accent.css"; ' +
                    '  [ -f "$d/gtk.css" ] || : > "$d/gtk.css"; grep -q "nyash-accent.css" "$d/gtk.css" || ' +
                    '  { printf "@import \"nyash-accent.css\";\n" | cat - "$d/gtk.css" > "$d/gtk.css.tmp" && mv "$d/gtk.css.tmp" "$d/gtk.css"; }; ' +
                    // старая строка «@import url(...)» — GTK3 её не понимает («Expected a string»)
                    // the old "@import url(...)" line: GTK3 doesn't understand it ("Expected a string")
                    '  sed -i "s|^@import url(\\"nyash-accent.css\\");|@import \\"nyash-accent.css\\";|" "$d/gtk.css"; done; ' +
                    // Qt-программы (платформенная тема KDE, см. config.conf) — полная цветовая схема в kdeglobals,
                    // как её пишет KDE при выборе схемы: фоны, текст, выделение, акцент. Строки «группа|ключ|цвет»
                    // Qt apps (KDE platform theme, see config.conf): a full colour scheme in kdeglobals,
                    // the way KDE writes it when a scheme is chosen: backgrounds, text, selection, accent. Lines are "group|key|colour"
                    'if command -v kwriteconfig6 >/dev/null; then ' +
                    '  printf "%s\\n" "$3" | while IFS="|" read -r g k v; do [ -n "$g" ] && kwriteconfig6 --file kdeglobals --group "$g" --key "$k" "$v"; done; ' +
                    // старые копии ярлыков Telegram/AyuGram (прошлое точечное решение) больше не нужны — убираем
                    // old copies of the Telegram/AyuGram shortcuts (the previous one-off fix) are no longer needed: removed
                    'fi; sh "$4" off; true',
                    "sh", css, h(p.accent), kde, Quickshell.shellPath("qt-apps.sh")]);
            }
            // DeltaChat: своя тема custom:nyashell (выбирается в его настройках → «Оформление»)
            // DeltaChat: its own custom:nyashell theme (chosen in its settings → "Appearance")
            if (ShellState.settings.deltaTheme ?? true) {
                // тема кладётся в обычный и во flatpak-DeltaChat; если DeltaChat закрыт — сразу и выбирается
                // (activeTheme в его config.json), открытый DeltaChat перезаписал бы эту настройку при выходе
                // the theme goes into both regular and flatpak DeltaChat; if DeltaChat is closed it's also selected right away
                // (activeTheme in its config.json); an open DeltaChat would overwrite that setting on exit
                Quickshell.execDetached(["sh", "-c",
                    'for c in "$HOME/.config/DeltaChat" "$HOME/.var/app/chat.delta.desktop/config/DeltaChat"; do ' +
                    '  [ "$c" = "$HOME/.config/DeltaChat" ] || [ -d "$c" ] || continue; ' +
                    '  mkdir -p "$c/custom-themes" && printf "%s" "$1" > "$c/custom-themes/nyashell.css"; ' +
                    '  if ! pgrep -i "^deltachat" >/dev/null && command -v python3 >/dev/null; then ' +
                    '    python3 -c \"import json,os,sys; p=sys.argv[1]; d=json.load(open(p)) if os.path.exists(p) else {}; d[sys.argv[2]]=sys.argv[3]; json.dump(d,open(p,sys.argv[4]))\" "$c/config.json" activeTheme custom:nyashell w; fi; ' +
                    'done', "sh", DT.build(Theme.p)]);
            }
            // Steam + Minimal Dark: цвета палитры и компактная верхняя панель для узкого окна
            // Steam + Minimal Dark: palette colours and a compact top bar for a narrow window
            if (ShellState.settings.steamTheme ?? true) {
                const sp = Theme.p, sh = (c) => String(c).slice(0, 7);
                Quickshell.execDetached(["sh", Quickshell.shellPath("steam-theme.sh"),
                    sh(sp.frame), sh(sp.surface), sh(sp.surfaceHi), sh(sp.text), sh(sp.textDim), sh(sp.accent)]);
            }
            // и тема для основного Firefox (применится при его следующем запуске)
            // and a theme for the main Firefox (applied on its next launch)
            if (ShellState.settings.firefoxTheme ?? true) {
                const p = Theme.p, h = (c) => String(c).slice(0, 7);
                Quickshell.execDetached(["sh", Quickshell.shellPath("firefox-theme.sh"),
                    h(p.frame), h(p.surface), h(p.surfaceHi), h(p.text), h(p.textDim), h(p.accent), h(p.onAccent), h(p.line)]);
            }
        }
    }
    onKittyChanged: write()
    Component.onCompleted: write()
}
