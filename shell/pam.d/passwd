#%PAM-1.0
# экран блокировки nyashell: только проверка пароля, без pam_faillock.
# faillock ведёт общий для всей системы счётчик ошибок — три промаха на блокировке
# запирали учётку на 10 минут и для TTY тоже. Перебор тормозит пауза после ошибки.
# nyashell lock screen: password check only, without pam_faillock.
# faillock keeps a system-wide failure counter: three misses on the lock screen
# locked the account for 10 minutes, on TTY too. Brute force is slowed by the delay after a failure.
auth    optional    pam_faildelay.so    delay=1500000
auth    required    pam_unix.so
