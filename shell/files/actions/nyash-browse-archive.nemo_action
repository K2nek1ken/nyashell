[Nemo Action]
# «Открыть как папку» для архивов (двойной клик делает то же самое)
Name=Browse as Folder
Name[ru]=Открыть как папку
Comment=Open %f as a folder: copy or drag files out of it
Comment[ru]=Открыть «%f» как папку: файлы можно копировать и перетаскивать
Exec=sh -c 'exec sh "$HOME/.config/quickshell/nyashell/files/archive-open.sh" "$@"' sh %U
Icon-Name=folder-symbolic
Selection=notnone
Mimetypes=application/zip;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/x-tar;application/x-compressed-tar;application/x-bzip-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-lzma-compressed-tar;application/gzip;application/x-gzip;application/x-iso9660-image;application/x-cd-image;application/vnd.ms-cab-compressed;application/x-cpio;application/x-lha;
Dependencies=fuse-archive;
